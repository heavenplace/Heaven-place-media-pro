# Production settings for docker-compose.prod.yml.
#
#   cp deploy/.env.prod.example .env.prod
#   # fill in every value below, then:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
#
# .env.prod holds real secrets and is git-ignored. Never commit it.

# The name this app is published on — a bare hostname, no scheme. Its DNS record has to
# point at this server BEFORE the first start: Caddy asks Let's Encrypt for a certificate
# for exactly this name, and the challenge only succeeds once the name resolves here.
#
# Both lines can be left blank. deploy/deploy.sh then fills them in as
# `<this server's public ip>.sslip.io` — a free name that resolves to whichever IP it is
# asked about and that Let's Encrypt issues for, which is exactly what a fresh Oracle Cloud
# VM needs, since it comes with no public hostname of its own (see deploy/oracle/README.md).
# For anything permanent, name a domain whose DNS you control — a registered domain, or a
# free DuckDNS subdomain — and put it here. streamcastpro.ct.ws cannot be used: it is
# InfinityFree's own domain and resolves to their shared hosting.
SITE_ADDRESS=
# The same name with its scheme. Used for CORS and as the Stripe checkout return url.
PUBLIC_ORIGIN=
# Optional: the public IP the sslip.io fallback above is built from, for a host that cannot
# look its own address up (deploy.sh asks api.ipify.org).
# PUBLIC_IP=

# The host ports Caddy binds. 80 and 443 are what the automatic certificate needs.
HTTP_PORT=80
HTTPS_PORT=443

# Postgres, running as the db service. Choose your own password.
POSTGRES_USER=streamcast
POSTGRES_PASSWORD=change-me
POSTGRES_DB=streamcast

# Signs every login session. Must be a long random string, and must not change later —
# a new value signs everyone out.  openssl rand -hex 32
JWT_SECRET=change-me

# The control-room account. Created on first boot; if you carry the existing database
# over, this address is already there (and keeps its own password).
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me

# Optional integrations — leave blank to switch the feature off.
GOOGLE_CLIENT_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PRCPAY_API_KEY=
PRCPAY_BASE_URL=
PRCPAY_ACCOUNT=streamcastpro
PRCPAY_WEBHOOK_IPS=

# Prices in cents.
PREMIUM_PRICE_CENTS=600
STATION_FEE_STANDARD_CENTS=500
STATION_FEE_PREMIUM_CENTS=1500
