# Local development defaults for the Base44 sandbox.
#
# These are NOT secrets — they only bootstrap the app so it starts with no
# credentials at all. Real secrets live in /run/base44/app.env (outside the
# repo), which is listed LAST in the api service's env_file so it always wins.
#
# Change these for a real deployment (the control-room account can also be
# promoted/changed from the Users screen once you are signed in).
ADMIN_EMAIL=admin@streamcast.pro
ADMIN_PASSWORD=control-room

# PrcPay — the instant payment rail. This points at the local stand-in service in
# docker-compose.base44.yml (prcpay-dev/), which is reachable on the stack's own
# network. Set PRCPAY_BASE_URL as a secret (or in the environment) to the real API
# host and the stand-in is never called; the secret always wins over this file.
# The endpoint paths are PRCPAY_CHARGE_PATH and PRCPAY_TRANSFER_PATH
# (defaults: /charge and /transfer).
PRCPAY_BASE_URL=http://prcpay:3001/api
